<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>PolicyWeaver.ReadContext</AssemblyName>
    <RootNamespace>PolicyWeaver.ReadContext</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/src/PolicyWeaver.ReadContext</PathMap>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(SignKeyPath)</AssemblyOriginatorKeyFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ReadContextPlugin.cs" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="[9.0.2.60]" />
  </ItemGroup>
  <Target Name="RequireSigningKey" BeforeTargets="CoreCompile">
    <Error Condition="'$(SignKeyPath)' == '' Or !Exists('$(SignKeyPath)')"
           Text="Supply an existing private strong-name key with -p:SignKeyPath. Keep the key outside the portable source and artifact package." />
  </Target>
</Project>
