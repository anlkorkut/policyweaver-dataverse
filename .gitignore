# Environments
.venv*/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local configuration: contains tenant, workspace, and environment ids.
config/config.yaml

# Run artifacts: snapshots contain the full user directory of a Dataverse
